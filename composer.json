{
    "name": "angrychimp/php-dkim",
    "type": "library",
    "description": "Finally, a PHP5 class for not just signing, but _verifying_ DKIM signatures.",
    "license": "MIT",
    "version": "0.4.0",
    "keywords": ["dkim", "signature", "verify"],
    "authors": [
        {
            "name": "Randall Kahler",
            "email": "rk@angrychimp.net"
        }
    ],
    "require": {
        "ext-openssl": "*",
        "ext-hash": "*"
    },
    "suggest": {
        "phpseclib/phpseclib": ">=0.3.6"
    },
    "autoload": {
        "psr-4": {
            "angrychimp\\DKIM\\": "src/DKIM/"
        },
        "files": ["src/aliases.php"]
    }
}
